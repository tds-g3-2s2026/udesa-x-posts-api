{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udesa-x:eventos:interaction.created.v1",
  "title": "interaction.created.v1",
  "description": "Una cuenta le dio like a un post, lo retweeteó o lo respondió. Lo publica posts-api; notifications-api avisa al autor del post.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": {
      "description": "Identificador único del evento. El consumidor lo usa para descartar repetidos.",
      "type": "string",
      "format": "uuid"
    },
    "source": { "const": "posts-api" },
    "type": { "const": "interaction.created.v1" },
    "time": {
      "description": "Instante en que se creó la interacción.",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["kind", "actor_id", "actor_handle", "post_id", "post_author_id", "reply_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Tipo de interacción. Un consumidor ignora los valores que no conoce, así sumar uno no rompe a nadie.",
          "enum": ["like", "retweet", "reply"]
        },
        "actor_id": {
          "description": "Cuenta que hizo la interacción.",
          "type": "string",
          "format": "uuid"
        },
        "actor_handle": {
          "description": "Handle de quien hizo la interacción, para el texto del mensaje. Null si posts-api no lo conoce.",
          "type": ["string", "null"]
        },
        "post_id": {
          "description": "Post que recibió la interacción. Es el que abre la app al tocar la notificación.",
          "type": "string",
          "format": "uuid"
        },
        "post_author_id": {
          "description": "Autor del post: la cuenta que recibe la notificación.",
          "type": "string",
          "format": "uuid"
        },
        "reply_id": {
          "description": "Post de la respuesta cuando kind es reply; null en los demás casos.",
          "type": ["string", "null"],
          "format": "uuid"
        }
      },
      "if": { "properties": { "kind": { "const": "reply" } } },
      "then": { "properties": { "reply_id": { "type": "string" } } },
      "else": { "properties": { "reply_id": { "type": "null" } } }
    }
  },
  "examples": [
    {
      "specversion": "1.0",
      "id": "0199f3a4-1b2c-7e3d-8f40-5a6b7c8d9e01",
      "source": "posts-api",
      "type": "interaction.created.v1",
      "time": "2026-10-23T14:07:30Z",
      "data": {
        "kind": "like",
        "actor_id": "0f8c2a5e-4b7d-4e1a-9c3f-2d6b8a1e5f70",
        "actor_handle": "juanperez",
        "post_id": "0199e8b1-5d6e-7f80-9a1b-2c3d4e5f6a7b",
        "post_author_id": "7a1d3c9b-2e4f-4a6b-8d0c-1f3e5a7b9c2d",
        "reply_id": null
      }
    },
    {
      "specversion": "1.0",
      "id": "0199f3a5-2c3d-7f4e-9051-6b7c8d9e0f12",
      "source": "posts-api",
      "type": "interaction.created.v1",
      "time": "2026-10-23T14:09:02Z",
      "data": {
        "kind": "reply",
        "actor_id": "0f8c2a5e-4b7d-4e1a-9c3f-2d6b8a1e5f70",
        "actor_handle": null,
        "post_id": "0199e8b1-5d6e-7f80-9a1b-2c3d4e5f6a7b",
        "post_author_id": "7a1d3c9b-2e4f-4a6b-8d0c-1f3e5a7b9c2d",
        "reply_id": "0199f3a5-2c3d-7f4e-9051-6b7c8d9e0f99"
      }
    }
  ]
}
